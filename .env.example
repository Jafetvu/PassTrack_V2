# Configuración MySQL
MYSQL_DATABASE=passtrack_db
MYSQL_USER=passtrack_user
MYSQL_PASSWORD=changeme_user_password
MYSQL_ROOT_PASSWORD=changeme_root_password

# Configuración Spring Boot
SPRING_PROFILES_ACTIVE=prod
